---
import Layout from '../layouts/Layout.astro';
import ModuleHeader from '../components/common/ModuleHeader.astro';
import DecimalToFraction from '../components/interactive/DecimalToFraction.svelte';
---

<Layout title="Fracciones • Módulo 1: Pasaje de Decimal a Fracción">
  <ModuleHeader
    moduleNumber={1}
    totalModules={1}
    prevHref="/"
    prevLabel="Inicio"
  />

  <main class="flex-1 flex flex-col">
    <DecimalToFraction client:load />

    <!-- Guía de Repaso Rápido al Pie -->
    <section class="p-4 mx-4 mb-6 lg:mx-8 lg:mb-8 lg:p-6 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 text-xs lg:text-sm space-y-2 transition-colors">
      <h4 class="font-bold text-slate-800 dark:text-slate-100 flex items-center gap-1.5 text-sm">
        <span>📖</span>
        <span>Reglas escolares para tu carpeta de 2° año</span>
      </h4>
      <ul class="space-y-1.5 text-slate-600 dark:text-slate-400 pl-1">
        <li>• <strong class="text-slate-900 dark:text-slate-200">Decimal Exacto:</strong> Todo el número sin coma sobre un 1 con tantos ceros como cifras decimales.</li>
        <li>• <strong class="text-slate-900 dark:text-slate-200">Periódico Puro:</strong> Todo el número sin coma menos la parte entera sobre tantos 9 como cifras periódicas.</li>
        <li>• <strong class="text-slate-900 dark:text-slate-200">Periódico Mixto:</strong> Todo el número sin coma menos la parte no periódica sobre tantos 9 como período y tantos 0 como anteperíodo.</li>
        <li>• <strong class="text-slate-900 dark:text-slate-200">Fracción Irreducible:</strong> Dividir numerador y denominador por el MCD.</li>
      </ul>
    </section>
  </main>
</Layout>
