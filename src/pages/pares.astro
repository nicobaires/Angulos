---
import Layout from '../layouts/Layout.astro';
import ModuleHeader from '../components/common/ModuleHeader.astro';
import AnglePairs from '../components/interactive/AnglePairs.svelte';
---

<Layout title="Módulo 2: Pares de Ángulos">
  <!-- Barra de Navegación Modular Reutilizable -->
  <ModuleHeader
    moduleNumber={2}
    prevHref="/clasificacion"
    prevLabel="Clasificación"
    nextHref="/paralelas"
    nextLabel="Paralelas"
  />

  <!-- Componente Interactivo Svelte -->
  <main class="flex-1 flex flex-col">
    <AnglePairs client:load />

    <!-- Guía de Repaso Rápido para la carpeta -->
    <section class="p-4 mx-4 mb-6 lg:mx-8 lg:mb-8 lg:p-6 bg-slate-50 dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 text-xs lg:text-sm space-y-2 select-none transition-colors">
      <h4 class="font-bold text-slate-800 dark:text-slate-100 flex items-center gap-1.5 text-sm">
        <span>📖</span>
        <span>Resumen para tu carpeta de 2° año</span>
      </h4>
      <ul class="space-y-1.5 text-slate-600 dark:text-slate-400 pl-1">
        <li>• <strong class="text-slate-900 dark:text-slate-200">Complementarios:</strong> Dos ángulos que suman <strong>90°</strong> (un ángulo recto).</li>
        <li>• <strong class="text-slate-900 dark:text-slate-200">Suplementarios:</strong> Dos ángulos que suman <strong>180°</strong> (un ángulo llano).</li>
        <li>• <strong class="text-slate-900 dark:text-slate-200">Adyacentes:</strong> Son consecutivos (comparten vértice y un lado) y suplementarios (forman una recta continua).</li>
        <li>• <strong class="text-slate-900 dark:text-slate-200">Opuestos por el vértice:</strong> Se forman cuando se cruzan dos rectas secantes. Los pares enfrentados <strong>siempre son congruentes</strong> (tienen exactamente la misma medida).</li>
      </ul>
    </section>
  </main>
</Layout>

